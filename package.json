{
  "name": "relax-zeal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "compile": "graphql-codegen",
    "watch": "graphql-codegen -w",
    "prod": "npm run build && mkdir archive && tar -czvf archive/zeal-app.tar.gz .next server.js public next.config.js",
    "prod-nm": "npm run build && mkdir archive && tar -czvf zeal-app.tar.gz .next server.js public next.config.js node_modules"
  },
  "dependencies": {
    "@apollo/client": "^3.7.15",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.13.0",
    "@types/node": "18.16.3",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "autoprefixer": "10.4.14",
    "eslint": "8.39.0",
    "eslint-config-next": "13.3.1",
    "graphql": "^16.6.0",
    "luxon": "^3.3.0",
    "next": "13.3.1",
    "postcss": "8.4.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-razorpay": "^2.0.1",
    "tailwindcss": "3.3.2",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^4.0.1",
    "@graphql-codegen/client-preset": "^4.0.0",
    "@types/luxon": "^3.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8"
  },
  "lint-staged": {
    "*.{js,css,md,tsx,ts}": "prettier --write"
  }
}
